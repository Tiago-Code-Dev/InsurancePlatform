{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Insurance_Proposal;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ProposalService": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Jwt": {
    "Key": "f8a43a67f57c42e688b1171c97d13d4c4d6a9f9277f24687a96a2fb7f73b9d62",
    "Issuer": "InsurancePlatform",
    "Audience": "InsurancePlatformUsers",
    "ExpireMinutes": 60
  },

  "RabbitMq": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "insurance.exchange",
    "Queues": {
      "ProposalCreated": "proposal-created"
    },
    "Durable": true,
    "PrefetchCount": 10
  },

  "AllowedHosts": "*"
}
